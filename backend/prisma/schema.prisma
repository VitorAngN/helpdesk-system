// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ENMU's

enum NivelAcesso{
  cliente
  agente
  admin
}
enum Status{
  aberto
  em_atendimento
  aguardando_cliente
  concluido
  cancelado
}
enum Prioridade{
  baixa
  media
  alta
}
enum Tipo{
  novo_chamado
  nova_mensagem
  chamado_concluido
  chamado_cancelado
}

//MODELS

model Usuario {
  idUsuario Int @id @default(autoincrement()) @db.UnsignedInt
  nome String @db.VarChar(100)
  email String @db.VarChar(100) @unique
  senha String @db.VarChar(255)
  nivelAcesso NivelAcesso
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Lado oposto: Um usuario vários chaamdos e varias mensagens e varias notificacoes
  agente Agente[]
  chamados Chamado[]
  mensagens Chat_Mensagem[]
  notificacoes Notificacao[]
  //Esta liha diz ao prisma: "O nome real dessa tabela lá no sql é usuarios"
  @@map("usuarios")
}

model Empresa {
  idEmpresa Int @id @default(autoincrement()) @db.UnsignedInt
  nome String @db.VarChar(150)
  cnpj String @db.VarChar(18) @unique
  email String @db.VarChar(100)
  ativo Boolean @default(true)
  createdAt DateTime @default(now())
  // Lado oposto: Uma empresa pode ter vários agentes e varios chamados
  agentes Agente[]
  chamados Chamado[]
  @@map("empresas")
}

model Agente {
  idAgente Int @id @default(autoincrement()) @db.UnsignedInt
  idUsuario Int @unique @db.UnsignedInt
  idEmpresa Int @db.UnsignedInt
  cargo String @default("agente") @db.VarChar(50)
  disponivel Boolean @default(true)
  // Lado oposto: Um agente pode ter varios chamados
  chamados Chamado[]

  // RELAÇÕES
  // O campo 'fields' é a coluna desta tabela. O 'references' é a coluna da outra tabela.
  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  empresa Empresa @relation(fields: [idEmpresa], references: [idEmpresa])

  @@map("agentes")
}

model Chamado {
  idChamado Int @id @db.UnsignedInt @default(autoincrement())
  protocolo String @db.VarChar(20) @unique
  idCliente Int @db.UnsignedInt
  idAgente Int? @db.UnsignedInt
  idEmpresa Int? @db.UnsignedInt
  titulo String @db.VarChar(150)
  descricao String @db.Text
  categoria String? @db.VarChar(50)
  status Status @default(aberto)
  prioridade Prioridade @default(media)
  anexo String? @db.VarChar(500)
  mimeTypeAnexo String? @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lado oposto: Um chamado pode ter varias mensagens e varias notificacoes
  mensagens Chat_Mensagem[]
  notificacoes Notificacao[]

  //RELAÇÕES
  cliente Usuario @relation(fields: [idCliente], references: [idUsuario])
  agente Agente? @relation(fields: [idAgente], references: [idAgente])
  empresa Empresa? @relation(fields: [idEmpresa], references: [idEmpresa])
  @@map("chamados")
}

model Chat_Mensagem{
  idMensagem Int @id @db.UnsignedInt @default(autoincrement())
  idChamado Int @db.UnsignedInt
  idRemetente Int @db.UnsignedInt
  mensagem String @db.Text
  anexo String? @db.VarChar(500)
  mimeTypeAnexo String? @db.VarChar(100)
  lida Boolean @default(false)
  createdAt DateTime @default(now())

  //RELAÇÕES
  chamado Chamado @relation(fields: [idChamado], references: [idChamado])
  remetente Usuario @relation(fields: [idRemetente], references: [idUsuario])
  @@map("chat_mensagens")
}

model Notificacao{
  idNotificacao Int @id @db.UnsignedInt @default(autoincrement())
  idUsuario Int @db.UnsignedInt
  idChamado Int? @db.UnsignedInt
  tipo Tipo
  lida Boolean @default(false)
  createdAt DateTime @default(now())

  //RELAÇÕES
  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  chamado Chamado? @relation(fields: [idChamado], references: [idChamado])
  @@map("notificacoes")
}

