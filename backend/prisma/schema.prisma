generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db { 
  provider = "mysql"
}

enum NivelAcesso {
  cliente
  agente
  admin
}

enum StatusChamado {
  aberto
  em_atendimento
  aguardando_cliente
  concluido
  cancelado
}

enum Prioridade {
  baixa
  media
  alta
}

enum TipoNotificacao {
  novo_chamado
  nova_mensagem
  chamado_concluido
  chamado_cancelado
}

model Usuario {
  idUsuario   Int         @id @default(autoincrement()) @map("idUsuario")
  nome        String      @db.VarChar(100)
  email       String      @unique(map: "uq_usuarios_email") @db.VarChar(100)
  senha       String      @db.VarChar(255)
  nivelAcesso NivelAcesso @map("nivelAcesso")
  createdAt   DateTime    @default(now()) @map("createdAt")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updatedAt")

  agente       Agente?
  chamados     Chamado[]      @relation("cliente_chamados")
  mensagens    ChatMensagem[] @relation("remetente_mensagens")
  notificacoes Notificacao[]  @relation("usuario_notificacoes")

  @@map("usuarios")
}

model Empresa {
  idEmpresa Int      @id @default(autoincrement()) @map("idEmpresa")
  nome      String   @db.VarChar(150)
  cnpj      String?  @unique(map: "uq_empresas_cnpj") @db.VarChar(18)
  email     String?  @db.VarChar(100)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("createdAt")

  agentes  Agente[]
  chamados Chamado[]

  @@map("empresas")
}

model Agente {
  idAgente   Int     @id @default(autoincrement()) @map("idAgente")
  idUsuario  Int     @unique(map: "uq_agentes_idUsuario") @map("idUsuario")
  idEmpresa  Int?    @map("idEmpresa")
  cargo      String  @default("agente") @db.VarChar(50)
  disponivel Boolean @default(true)

  usuario  Usuario   @relation(fields: [idUsuario], references: [idUsuario], map: "fk_agentes_usuario")
  empresa  Empresa?  @relation(fields: [idEmpresa], references: [idEmpresa], map: "fk_agentes_empresa")
  chamados Chamado[]

  @@map("agentes")
}

model Chamado {
  idChamado     Int           @id @default(autoincrement()) @map("idChamado")
  protocolo     String        @unique(map: "uq_chamados_protocolo") @db.VarChar(20)
  idCliente     Int           @map("idCliente")
  idAgente      Int?          @map("idAgente")
  idEmpresa     Int?          @map("idEmpresa")
  titulo        String        @db.VarChar(150)
  descricao     String        @db.Text
  categoria     String?       @db.VarChar(50)
  status        StatusChamado @default(aberto)
  prioridade    Prioridade    @default(media)
  anexo         String?       @db.VarChar(500)
  mimeTypeAnexo String?       @map("mimeTypeAnexo") @db.VarChar(100)
  createdAt     DateTime      @default(now()) @map("createdAt")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updatedAt")

  cliente      Usuario        @relation("cliente_chamados", fields: [idCliente], references: [idUsuario], map: "fk_chamados_cliente")
  agente       Agente?        @relation(fields: [idAgente], references: [idAgente], map: "fk_chamados_agente")
  empresa      Empresa?       @relation(fields: [idEmpresa], references: [idEmpresa], map: "fk_chamados_empresa")
  mensagens    ChatMensagem[]
  notificacoes Notificacao[]

  @@index([idCliente], map: "idx_chamados_idCliente")
  @@index([idAgente], map: "idx_chamados_idAgente")
  @@index([status], map: "idx_chamados_status")
  @@map("chamados")
}

model ChatMensagem {
  idMensagem    Int      @id @default(autoincrement()) @map("idMensagem")
  idChamado     Int      @map("idChamado")
  idRemetente   Int      @map("idRemetente")
  mensagem      String?  @db.Text
  anexo         String?  @db.VarChar(500)
  mimeTypeAnexo String?  @map("mimeTypeAnexo") @db.VarChar(100)
  lida          Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("createdAt")

  chamado   Chamado @relation(fields: [idChamado], references: [idChamado], map: "fk_chat_chamado")
  remetente Usuario @relation("remetente_mensagens", fields: [idRemetente], references: [idUsuario], map: "fk_chat_remetente")

  @@index([idChamado], map: "idx_chat_idChamado")
  @@index([idRemetente], map: "idx_chat_idRemetente")
  @@map("chat_mensagens")
}

model Notificacao {
  idNotificacao Int             @id @default(autoincrement()) @map("idNotificacao")
  idUsuario     Int             @map("idUsuario")
  idChamado     Int?            @map("idChamado")
  tipo          TipoNotificacao
  lida          Boolean         @default(false)
  createdAt     DateTime        @default(now()) @map("createdAt")

  usuario Usuario  @relation("usuario_notificacoes", fields: [idUsuario], references: [idUsuario], map: "fk_notif_usuario")
  chamado Chamado? @relation(fields: [idChamado], references: [idChamado], map: "fk_notif_chamado")

  @@index([idUsuario], map: "idx_notif_idUsuario")
  @@index([lida], map: "idx_notif_lida")
  @@map("notificacoes")
}
